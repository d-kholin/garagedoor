# Garage admin API (v2) — server-side only, never exposed to the browser
GARAGE_ADMIN_ENDPOINT=http://localhost:3903
GARAGE_ADMIN_TOKEN=change-me

# Max time (ms) to wait for any single admin API call before showing an error.
# Multi-node calls can hang while RPCs to a just-crashed node time out.
GARAGE_ADMIN_TIMEOUT_MS=8000

# Timeout for expensive per-node endpoints (GetNodeStatistics, ListWorkers…) —
# `garage stats` can take 30s+ on a loaded cluster.
GARAGE_ADMIN_SLOW_TIMEOUT_MS=180000

# Set to true to refuse ALL mutating admin calls server-side — the app becomes
# a pure dashboard. Recommended when pointing at a production cluster.
GARAGEDOOR_READ_ONLY=false

# Where the server keeps persisted resync history (JSONL). In Docker this is
# a volume at /data.
GARAGEDOOR_DATA_DIR=./data

# Background stats sampling cadence for history/ETA. Default 30 minutes —
# GetNodeStatistics is expensive on real clusters. Use 60000 on dev clusters.
GARAGEDOOR_SAMPLE_INTERVAL_MS=1800000

# How long to retain history samples.
GARAGEDOOR_HISTORY_RETENTION_DAYS=30
