# Garage admin API (v2) — server-side only, never exposed to the browser
GARAGE_ADMIN_ENDPOINT=http://localhost:3903
GARAGE_ADMIN_TOKEN=change-me

# Garage S3 API — used by the read-only object browser
GARAGE_S3_ENDPOINT=http://localhost:3900
GARAGE_S3_REGION=garage

# Max time (ms) to wait for any single admin API call before showing an error.
# Multi-node calls can hang while RPCs to a just-crashed node time out.
GARAGE_ADMIN_TIMEOUT_MS=8000
